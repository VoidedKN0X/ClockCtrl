    <!-- Export and import -->
    <string name="backup_title">Export and import</string>
    <string name="backup_footer">Alarms and settings are saved as JSON files in a place you pick, to move them to another phone or keep a copy. A settings file never holds the app lock or its PIN, and importing one can\'t turn the app lock, Hide in screenshots or Hide in recent apps off. Timer sounds aren\'t included; an alarm sound that doesn\'t exist on this phone becomes the default alarm sound.</string>
