    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Alarms, timers, clock and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening ClockCtrl. Ringing alarms and timers can always be stopped.</string>
    <string name="app_lock_footer">ClockCtrl works fully offline: it has no internet permission, analytics or tracking. Your alarms, timers and cities stay on this phone.</string>
    <string name="lock_prompt_subtitle">Your alarms and timers</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. ClockCtrl will reset its own settings and turn the app lock off. Your alarms, timers and cities are kept, so no alarm is missed. If your phone has a screen lock, you\'ll confirm with it first.</string>
    <string name="lock_reset_prompt_title">Reset ClockCtrl\'s app lock</string>
    <string name="lock_reset_prompt_subtitle">Use your phone\'s screen lock to confirm it\'s you</string>
    <string name="lock_reset_prompt_failed">Couldn\'t show the screen lock prompt</string>

